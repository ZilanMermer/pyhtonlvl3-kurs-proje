import discord
from discord import app_commands
import sqlite3
import random

TOKEN = "token_yaz"

intents = discord.Intents.default()
intents.message_content = True                 

bot = discord.Client(intents=intents)
komutlar = app_commands.CommandTree(bot)

# veritabanini olustur
db = sqlite3.connect("kariyer.db")
imlec = db.cursor()

#Discord'da kariyer botu yapmak için gerekli kütüphaneleri ekledim, botu oluşturdum ve bilgileri kaydetmek için veritabanını hazırladım.


imlec.execute("""
CREATE TABLE IF NOT EXISTS meslekler (
    ad TEXT,
    alan TEXT,
    aciklama TEXT,
    beceri TEXT
)
""")

imlec.execute("""
CREATE TABLE IF NOT EXISTS kullanicilar (
    id TEXT PRIMARY KEY,
    alan TEXT
)
""")

#Meslek bilgilerini ve kullanıcıların seçtikleri kariyer alanlarını saklamak için veritabanında iki tablo oluşturdum.

# ornek meslekleri ekleme bolumu
