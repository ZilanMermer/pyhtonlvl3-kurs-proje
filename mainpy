db.commit()

#Veritabanında daha önce meslek eklenip eklenmediğini kontrol ettim, eğer eklenmemişse örnek meslekleri ve bilgilerini tabloya ekleyip kaydettim.


@bot.event
async def on_ready():
    await komutlar.sync()
    print("KariyerPusulasi hazir!")
    print("Bot Discord'a baglandi.")

    #Bot Discord'a bağlandığında komutları senkronize ettim ve botun hazır olduğunu belirten mesajların ekrana yazdırılmasını sağladım.

@komutlar.command(
    name="basla",
    description="Kariyer kesfine basla"
)
async def basla(interaction: discord.Interaction):

    secenekler = [
        discord.SelectOption(label="Teknoloji"),
        discord.SelectOption(label="Sanat"),
        discord.SelectOption(label="Saglik"),
        discord.SelectOption(label="Insan"),
        discord.SelectOption(label="Isletme")
    ]

    menu = discord.ui.Select(
        placeholder="Ilgi alanini sec",
        options=secenekler
    )

    async def secim_yap(interaction2: discord.Interaction):
        alan = menu.values[0]

        db.execute(
            "INSERT OR REPLACE INTO kullanicilar VALUES (?, ?)",
            (str(interaction2.user.id), alan)
        )
        db.commit()

        await interaction2.response.send_message(
            f"Ilgi alanin: **{alan}**\n"
            "Meslek onerilerini gormek icin `/sonuc` yaz!",
            ephemeral=True
        )

    menu.callback = secim_yap

    gorunum = discord.ui.View()
    gorunum.add_item(menu)

    await interaction.response.send_message(
        "Merhaba! KariyerPusulasi'na hos geldin.\n"
        "Sana uygun meslekleri bulmak icin bir alan sec:",
        view=gorunum,
        ephemeral=True
    )

#Kullanıcıların `/basla` komutuyla kariyer botuna başlamasını, ilgi alanlarını menüden seçmesini ve seçtikleri alanın veritabanına kaydedilmesini sağladım.


@komutlar.command(
    name="sonuc",
    description="Sana uygun meslekleri goster"
)
async def sonuc(interaction: discord.Interaction):

    kayit = db.execute(
        "SELECT alan FROM kullanicilar WHERE id = ?",
        (str(interaction.user.id),)
    ).fetchone()

    if kayit is None:
        await interaction.response.send_message(
            "Once `/basla` komutunu kullan!",
            ephemeral=True
        )
        return

    alan = kayit[0]

    sonuc_listesi = db.execute(
        "SELECT ad, aciklama, beceri FROM meslekler "
        "WHERE alan = ?",
        (alan,)
    ).fetchall()

    if not sonuc_listesi:
        await interaction.response.send_message(
            "Bu alanda meslek bulunamadi."
        )
        return

    secilen = random.choice(sonuc_listesi)

    mesaj = discord.Embed(
        title="Sana bir meslek onerimiz var!",
        description=f"**{secilen[0]}**\n{secilen[1]}",
        color=discord.Color.blue()
    )

    mesaj.add_field(
        name="Gerekli beceriler",
        value=secilen[2],
        inline=False
    )

    mesaj.set_footer(
        text="Bu oneriler kesif amacli dir."
    )

    await interaction.response.send_message(embed=mesaj)

    #Kullanıcının seçtiği ilgi alanına göre veritabanından rastgele bir meslek seçip mesleğin açıklamasını ve gerekli becerilerini Discord üzerinden göstermesini sağladım.

@bot.event
async def on_message(message):
    if message.author.bot:
        return

    if "meslek" in message.content.lower():
        await message.channel.send(
            "Meslek onerisi almak icin `/basla` "
            "ve ardindan `/sonuc` kullanabilirsin!"
        )

if TOKEN == "token_yaz":
    print("Once TOKEN degiskenine bot tokenini yaz!")
else:
    bot.run(TOKEN)

    #Mesajlarda "meslek" kelimesi geçtiğinde kullanıcıya botun komutlarını hatırlatan bir mesaj gönderdim ve botun token kontrolünü yaparak çalışmasını sağladım.
